# RoomSense AI runs private/local by default.
# Leave these empty unless you explicitly want external AI analysis.

PORT=3000
HTTPS_PORT=3443
ROOMSENSE_HTTPS=true
ROOMSENSE_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY

# OpenAI-compatible endpoint, for example:
# AI_API_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llava:latest
# AI_PROVIDER_LABEL=Local Ollama
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_LABEL=OpenAI-compatible
